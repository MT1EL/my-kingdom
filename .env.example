# Copy to .env for local development. Vite reads these at build time and
# bakes them into the bundle, so a change needs the dev server restarted
# (or a rebuild). Only variables prefixed VITE_ are exposed to the browser
# — never put a secret here.

# --- the API -------------------------------------------------------
# Where the API lives, as an ORIGIN with no trailing "/api". Leave unset in
# development (Vite proxies /api to localhost:4000) and in a single-domain
# deployment. Set it when the site and the API are on different hosts.
# VITE_API_URL=https://mykingdom-api.onrender.com

# --- booking -------------------------------------------------------
# "false" takes the booking flow off the site: every call to action
# disappears — navbar, footer, page CTAs, programme cards — and /booking
# redirects to the home page so existing links do not 404. Anything else,
# including unset, leaves it on. The code stays in the repository.
#
# This hides the interface only. Set BOOKING_ENABLED=false in server/.env
# as well, or the API still accepts bookings from anything calling it
# directly. See DEPLOYMENT.md → "Turning booking off".
VITE_BOOKING_ENABLED=true
