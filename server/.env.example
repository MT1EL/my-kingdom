# Copy to .env and fill in before deploying. The values here are the
# defaults, which are what local development uses.

NODE_ENV=development
PORT=4000

# --- database ------------------------------------------------------
# PostgreSQL. Required — there is no default.
#
# For local development you do NOT need Postgres installed: run
#   npm run db:local
# in another terminal and use the URL below. It is a real PostgreSQL build
# (PGlite) behind a socket, storing its data in server/data/pglite.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# `npm run db:local` serves one connection at a time, so the pool must be 1.
# Managed Postgres has no such limit — leave this unset in production.
DATABASE_POOL_SIZE=1

# --- photo uploads -------------------------------------------------
# "disk"       — writes into UPLOAD_DIR. Needs a persistent volume in
#                production.
# "database"   — keeps the bytes in Postgres and serves them from the API.
#                What Render's free tier uses: no disk, no object storage.
# "cloudinary" — offloads to Cloudinary's CDN.
STORAGE_DRIVER=disk
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=12582912

# Required when STORAGE_DRIVER=cloudinary (Cloudinary dashboard → API keys).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=mykingdom

# --- auth ----------------------------------------------------------
# REQUIRED in production — signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_DAYS=14

# The first dashboard account, created on first boot.
ADMIN_EMAIL=admin@mykingdom.ge
ADMIN_PASSWORD=
ADMIN_NAME=ადმინისტრატორი

# Serve the built dashboard from this server at /admin, so its login cookie
# stays first-party. Used in production; locally the dashboard has its own
# dev server on :5174.
# SERVE_ADMIN=false

# --- browser origins -----------------------------------------------
# Comma-separated. Required in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
