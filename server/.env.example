# Copy to .env and fill in before deploying. Values here are the defaults.

NODE_ENV=development
PORT=4000

# libSQL / SQLite. A file: URL keeps everything in one file you can back up.
DATABASE_URL=file:./data/mykingdom.db
# DATABASE_AUTH_TOKEN=   # only for a hosted libSQL (Turso) database

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# REQUIRED in production — signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_DAYS=14

# The first dashboard account, created by `npm run seed`.
ADMIN_EMAIL=admin@mykingdom.ge
ADMIN_PASSWORD=
ADMIN_NAME=ადმინისტრატორი

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=12582912
